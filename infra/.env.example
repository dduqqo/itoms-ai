# docker compose가 읽는 값. 이 파일을 .env로 복사해서 값을 채운다. (.env는 커밋하지 않는다)
#   cp infra/.env.example infra/.env

# ── MySQL (모든 서비스가 한 DB를 함께 쓴다) ──
DB_NAME=itoms
DB_USER=root
DB_PASSWORD=change-me

# create | update | validate | none
DDL_ENV=update

# Swagger 경로 앞에 붙는 값. 비워 두면 /swagger-ui.html
SWAGGER_PATH=

# ── ticket-core 임시 CORS (게이트웨이 라우팅 전까지 브라우저 직접 테스트용, 7~8단계에서 제거) ──
ALLOWED_PATH=/**
ALLOWED_PATTERN=http://localhost:*
ALLOWED_METHOD=GET,POST,PUT,PATCH,DELETE,OPTIONS

# ── 관측 ──
# true로 바꾸고 --profile observability로 띄우면 트레이스를 Tempo로 보낸다
TRACING_ENABLED=false

# ── 호스트 포트 (이미 쓰는 포트와 겹치면 바꾼다. 컨테이너 안 포트는 그대로) ──
# GATEWAY_PORT=9000
# SERVICE_DESK_PORT=8080
# USER_SERVICE_PORT=8081
# TICKET_CORE_PORT=8082
# SRM_PORT=8083
# MYSQL_HOST_PORT=3306
# KAFKA_HOST_PORT=9092
